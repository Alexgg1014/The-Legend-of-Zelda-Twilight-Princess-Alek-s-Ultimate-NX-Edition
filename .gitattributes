# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.py   text

# Enforce platform-specific encodings
*.bat  text eol=crlf
*.sh   text eol=lf
*.sha1 text eol=lf

# decomp-toolkit writes files with LF
config/**/*.txt  text eol=lf

# The test packages under platforms/switch/test-mods are packed byte for byte into .dusk
# files (platforms/switch/tools/make_dusk.py) whose SHA-256 is documented and compared, so
# they are LF in every checkout, whatever core.autocrlf says. test-dusk-reproducible.sh
# checks it.
platforms/switch/test-mods/** text=auto eol=lf

# Patch files: an empty context line in a unified diff is a single space, which whitespace
# checks would report. LF, so they apply the same on every checkout.
*.patch -whitespace text eol=lf
