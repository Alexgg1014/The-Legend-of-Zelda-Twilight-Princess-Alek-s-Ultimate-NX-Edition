From: aleks2 (H37-c9)
Subject: [PATCH 8/8] entropy for the seed on the console

std::random_device has no entropy source in the console's libstdc++ and returns the same sequence in
every process, so every generation started from the same state: one seed string, one hash, one seed.
utility::random::EntropySeed() mixes it with the monotonic clock, a counter and an address (splitmix
finalizer) and replaces the three direct uses: the generator's own seeding, SeedRNG, and the random
seed-string and hash words.
---
diff --git a/generator/seedgen/config.cpp b/generator/seedgen/config.cpp
index fe0a6f6..c5fb148 100644
--- a/generator/seedgen/config.cpp
+++ b/generator/seedgen/config.cpp
@@ -569,7 +569,7 @@ namespace randomizer::seedgen::config
                 bool ignoreInvalidPlandomizer /* = true */)
     {
         // Seed with system time incase we have to choose random preferences during seeding
-        auto seed = static_cast<uint32_t>(std::random_device {}());
+        auto seed = utility::random::EntropySeed();
         utility::random::RandomInit(seed);
 
         // Seed the rng using a combination of the seed and standard settings
diff --git a/generator/seedgen/seed.cpp b/generator/seedgen/seed.cpp
index 30407f2..22e11fd 100644
--- a/generator/seedgen/seed.cpp
+++ b/generator/seedgen/seed.cpp
@@ -93,8 +93,7 @@ namespace randomizer::seedgen::seed
 
     int GetRandValue(int min, int max) {
         std::uniform_int_distribution<int> distribution(min, max);
-        std::random_device rd;
-        std::mt19937 engine(rd());
+        std::mt19937 engine(utility::random::EntropySeed());
         return distribution(engine);
     }
 
diff --git a/generator/utility/random.cpp b/generator/utility/random.cpp
index 7631196..4bbd55f 100644
--- a/generator/utility/random.cpp
+++ b/generator/utility/random.cpp
@@ -1,10 +1,27 @@
 #include "../utility/random.hpp"
 
+#include <atomic>
+#include <chrono>
+
 namespace randomizer::utility::random
 {
     static bool init = false;
     static std::mt19937_64 generator;
 
+    uint32_t EntropySeed()
+    {
+        static std::atomic<uint32_t> counter{0};
+        uint64_t x = static_cast<uint64_t>(std::chrono::steady_clock::now().time_since_epoch().count());
+        x += 0x9E3779B97F4A7C15ull * (static_cast<uint64_t>(counter.fetch_add(1, std::memory_order_relaxed)) + 1);
+        x ^= static_cast<uint64_t>(std::random_device {}());
+        x ^= static_cast<uint64_t>(reinterpret_cast<uintptr_t>(&counter)) << 7;
+        // splitmix64 finalizer
+        x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ull;
+        x = (x ^ (x >> 27)) * 0x94D049BB133111EBull;
+        x ^= x >> 31;
+        return static_cast<uint32_t>(x ^ (x >> 32));
+    }
+
     // Initialize with seed specified
     void RandomInit(size_t seed)
     {
@@ -18,7 +35,7 @@ namespace randomizer::utility::random
         if (!init)
         {
             // No seed given, get a random number from device to seed
-            const auto seed = static_cast<uint32_t>(std::random_device {}());
+            const auto seed = EntropySeed();
             RandomInit(seed);
         }
 
diff --git a/generator/utility/random.hpp b/generator/utility/random.hpp
index 8a256b5..6dab683 100644
--- a/generator/utility/random.hpp
+++ b/generator/utility/random.hpp
@@ -10,6 +10,10 @@
 namespace randomizer::utility::random
 {
     void RandomInit(size_t seed);
+    // A 32-bit seed that differs from one call and one run to the next. On the console libstdc++ has no
+    // entropy source, so std::random_device returns the same sequence in every process and every seed
+    // came out identical: this mixes it with the monotonic clock, a counter and an address.
+    uint32_t EntropySeed();
     uint32_t Random(int min, int max);
     double RandomDouble();
     std::mt19937_64& GetGenerator();
