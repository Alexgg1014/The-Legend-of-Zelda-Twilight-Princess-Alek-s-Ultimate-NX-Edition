index 0000000..bdc8075
--- /dev/null
+++ b/src/session_lifecycle.hpp
@@ -0,0 +1,254 @@
+// aleks2 (H38): the Randomizer's game-mode lifecycle as one idempotent state machine.
+//
+// What went wrong. onGameModeDeactivated() and mod_shutdown() both ran the whole teardown, so a handle freed by the
+// first (the menu tab) was freed again by the second and the host logged "unregister_menu_tab: stale handle"; a
+// failure half way through onGameModeActivated() left whatever was acquired before it behind; and the preload thread
+// was only joined by one of the two paths.
+//
+// What this is. Every resource the game mode acquires has one acquire step and one release step, run in a fixed
+// order. Lifecycle records which were acquired, rolls back in reverse if an acquire fails, and releases each exactly
+// once however many times shutdown() is called. release_handle() is the idiom for the handle-shaped ones: the handle
+// is invalidated (0, which is never a valid handle) before the service is asked to free it, so a second release is a
+// no-op. Nothing here touches the game, so test-randomizer-lifecycle.sh drives it with fake services and counters.
+#pragma once
+
+#include "large_stack_thread.hpp"
+#include "session.hpp"
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <exception>
+#include <functional>
+#include <optional>
+#include <utility>
+
+namespace randomizer::session {
+
+// Frees `handle` through `unregister(handle)` once and leaves it 0. Returns whether it freed anything.
+template <class Handle, class Unregister>
+bool release_handle(Handle& handle, Unregister&& unregister) {
+    if (handle == 0) {
+        return false;
+    }
+    const Handle live = handle;
+    handle = 0;
+    std::forward<Unregister>(unregister)(live);
+    return true;
+}
+
+enum class State { Inactive, Activating, Active, ShuttingDown };
+
+// In acquisition order; released in the reverse order. The preload thread comes last so that it is joined before
+// anything it could touch (the seed state, the UI, the services) is taken down.
+enum class Resource : int { Hooks, SaveObserver, TextureReplacement, Ui, Seed, PreloadThread, Count };
+constexpr std::size_t kResourceCount = static_cast<std::size_t>(Resource::Count);
+
+class Lifecycle {
+public:
+    struct Step {
+        std::function<bool()> acquire;   // true if the resource is now held; a failing acquire cleans up after itself
+        std::function<void()> release;   // called once per successful acquire
+    };
+    using Steps = std::array<Step, kResourceCount>;
+
+    explicit Lifecycle(Steps steps) : m_steps(std::move(steps)) {}
+
+    State state() const { return m_state; }
+    bool held(Resource r) const { return m_held[static_cast<std::size_t>(r)]; }
+
+    // Acquires every resource in order. On the first failure the ones already held are released in reverse and the
+    // failing resource is returned. Already Active: nothing to do. Busy (activating or shutting down): refused.
+    std::optional<Resource> activate() {
+        if (m_state == State::Active) {
+            return std::nullopt;
+        }
+        if (m_state != State::Inactive) {
+            return Resource::Hooks;
+        }
+        m_state = State::Activating;
+        for (std::size_t i = 0; i < kResourceCount; ++i) {
+            bool ok = false;
+            try {
+                ok = m_steps[i].acquire && m_steps[i].acquire();
+            } catch (...) {
+                ok = false;
+            }
+            if (!ok) {
+                release_held();
+                m_state = State::Inactive;
+                return static_cast<Resource>(i);
+            }
+            m_held[i] = true;
+        }
+        m_state = State::Active;
+        return std::nullopt;
+    }
+
+    // Releases what is held, in reverse. Safe to call any number of times, in any state.
+    void shutdown() {
+        if (m_state == State::Inactive || m_state == State::ShuttingDown) {
+            return;
+        }
+        m_state = State::ShuttingDown;
+        release_held();
+        m_state = State::Inactive;
+    }
+
+private:
+    void release_held() {
+        for (std::size_t i = kResourceCount; i-- > 0;) {
+            if (!m_held[i]) {
+                continue;
+            }
+            m_held[i] = false;
+            try {
+                if (m_steps[i].release) {
+                    m_steps[i].release();
+                }
+            } catch (...) {
+                // One failed release must not leave the ones below it held.
+            }
+        }
+    }
+
+    Steps m_steps;
+    std::array<bool, kResourceCount> m_held{};
+    State m_state = State::Inactive;
+};
+
+// The game-side work the lifecycle drives (hooks, UI, seed state, the preload itself), so that the lifecycle's own
+// glue to the services can be tested without the game.
+struct GameCallbacks {
+    std::function<ModResult()> hooks_initialize;
+    std::function<void()> hooks_uninstall;  // also the rollback of a hooks_initialize that failed half way
+    std::function<ModResult()> ui_initialize;
+    std::function<void()> ui_shutdown;
+    std::function<void()> deactivate_seed;
+    // Runs on the preload thread. Must return soon after `cancel` becomes true.
+    std::function<void(const std::atomic<bool>& cancel)> preload;
+    SaveEventFn on_save_written = nullptr;
+    const char* logo_texture = nullptr;
+};
+
+// The Randomizer's resources over the real service tables (fake ones in tests).
+class SessionResources {
+public:
+    SessionResources(const ServiceManager& services, GameCallbacks game)
+        : m_svc(services), m_game(std::move(game)), m_lifecycle(make_steps()) {}
+    SessionResources(const SessionResources&) = delete;
+    SessionResources& operator=(const SessionResources&) = delete;
+    ~SessionResources() { shutdown(); }
+
+    struct Failure {
+        Resource resource;
+        ModResult code;
+    };
+
+    std::optional<Failure> activate() {
+        m_failCode = MOD_ERROR;
+        if (const auto failed = m_lifecycle.activate()) {
+            return Failure{*failed, m_failCode};
+        }
+        return std::nullopt;
+    }
+    void shutdown() { m_lifecycle.shutdown(); }
+    State state() const { return m_lifecycle.state(); }
+    bool held(Resource r) const { return m_lifecycle.held(r); }
+
+    static const char* failure_message(Resource r) {
+        switch (r) {
+        case Resource::Hooks: return "failed to initialize hooks";
+        case Resource::SaveObserver: return "failed to initialize save observation";
+        case Resource::TextureReplacement: return "failed to register texture replacement";
+        case Resource::Ui: return "failed to initialize ui";
+        case Resource::Seed: return "failed to prepare the seed state";
+        case Resource::PreloadThread: return "failed to start the data preload thread";
+        default: return "failed to activate the randomizer";
+        }
+    }
+
+private:
+    Lifecycle::Steps make_steps() {
+        Lifecycle::Steps steps;
+        steps[index(Resource::Hooks)] = {
+            [this] {
+                const ModResult r = m_game.hooks_initialize();
+                if (r != MOD_OK) {
+                    m_failCode = r;
+                    m_game.hooks_uninstall();  // some hooks may be in
+                    return false;
+                }
+                return true;
+            },
+            [this] { m_game.hooks_uninstall(); }};
+        steps[index(Resource::SaveObserver)] = {
+            [this] {
+                const ModResult r = m_svc.save->observe_saves(
+                    m_svc.mod_ctx, nullptr, nullptr, m_game.on_save_written, nullptr, &m_saveObserver);
+                if (r != MOD_OK) {
+                    m_failCode = r;
+                    m_saveObserver = 0;
+                    return false;
+                }
+                return true;
+            },
+            [this] {
+                release_handle(m_saveObserver,
+                    [this](SaveObserverHandle h) { m_svc.save->unobserve_saves(m_svc.mod_ctx, h); });
+            }};
+        steps[index(Resource::TextureReplacement)] = {
+            [this] {
+                const ModResult r =
+                    m_svc.texture->register_file(m_svc.mod_ctx, m_game.logo_texture, &m_logoTexture);
+                if (r != MOD_OK) {
+                    m_failCode = r;
+                    m_logoTexture = 0;
+                    return false;
+                }
+                return true;
+            },
+            [this] {
+                release_handle(m_logoTexture,
+                    [this](TextureReplacementHandle h) { m_svc.texture->unregister(m_svc.mod_ctx, h); });
+            }};
+        steps[index(Resource::Ui)] = {
+            [this] {
+                const ModResult r = m_game.ui_initialize();
+                if (r != MOD_OK) {
+                    m_failCode = r;
+                    return false;
+                }
+                return true;
+            },
+            [this] { m_game.ui_shutdown(); }};
+        steps[index(Resource::Seed)] = {
+            [] { return true; },  // a seed is activated later, by a new or loaded save; this releases it
+            [this] { m_game.deactivate_seed(); }};
+        steps[index(Resource::PreloadThread)] = {
+            [this] {
+                m_cancel.store(false);
+                m_preload = LargeStackThread{[this] { m_game.preload(m_cancel); }};
+                return true;  // a thread that cannot start throws, which Lifecycle counts as a failure
+            },
+            [this] {
+                m_cancel.store(true);
+                if (m_preload.joinable()) {
+                    m_preload.join();
+                }
+            }};
+        return steps;
+    }
+    static constexpr std::size_t index(Resource r) { return static_cast<std::size_t>(r); }
+
+    const ServiceManager& m_svc;
+    GameCallbacks m_game;
+    SaveObserverHandle m_saveObserver = 0;
+    TextureReplacementHandle m_logoTexture = 0;
+    LargeStackThread m_preload;
+    std::atomic<bool> m_cancel{false};
+    ModResult m_failCode = MOD_ERROR;
+    Lifecycle m_lifecycle;  // last: its steps capture `this` and the members above
+};
+
+}  // namespace randomizer::session
