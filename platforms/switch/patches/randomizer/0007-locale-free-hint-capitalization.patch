@@ -0,0 +1,17 @@
+#pragma once
+
+namespace randomizer::utility::latin1 {
+
+// The generator stores western translations as single-byte Latin-1/CP1252 text.
+// Keep capitalization deterministic and independent of the host's installed locales.
+constexpr unsigned char uppercase(unsigned char c) {
+    if (c >= static_cast<unsigned char>('a') && c <= static_cast<unsigned char>('z')) {
+        return static_cast<unsigned char>(c - ('a' - 'A'));
+    }
+    if ((c >= 0xE0 && c <= 0xF6) || (c >= 0xF8 && c <= 0xFE)) {
+        return static_cast<unsigned char>(c - 0x20);
+    }
+    return c;
+}
+
+}  // namespace randomizer::utility::latin1
