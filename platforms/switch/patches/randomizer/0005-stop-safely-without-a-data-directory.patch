+std::optional<std::filesystem::path> GetRandomizerPath() {
+    static std::mutex mutex;
+    static std::optional<std::filesystem::path> resolved;
+    static bool failed = false;
+
+    std::lock_guard lock{mutex};
+    if (resolved) {
+        return resolved;
+    }
+    if (failed) {
+        return std::nullopt;
+    }
+    resolved = ResolveDataDir(session::svc_mng.host, session::svc_mng.mod_ctx);
+    if (!resolved) {
+        // fail() returns: it marks the mod failed and the loader disables it at the next safe point.
+        failed = true;
         session::svc_mng.host->fail(session::svc_mng.mod_ctx, MOD_ERROR, "Failed to get data directory");
     }
+    return resolved;
+}
 
-    return reinterpret_cast<const char8_t*>(dataDir);
+namespace {
+std::optional<std::filesystem::path> Below(const char* name) {
+    auto base = GetRandomizerPath();
+    if (!base) {
+        return std::nullopt;
+    }
+    return *base / name;
 }
