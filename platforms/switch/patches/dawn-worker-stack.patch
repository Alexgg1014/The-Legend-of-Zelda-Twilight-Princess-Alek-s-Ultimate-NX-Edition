+void* AsyncJobHandleImpl::SwitchThreadEntry(void* self) {
+    auto* job = static_cast<AsyncJobHandleImpl*>(self);
+    job->JobThreadLoop(job->mCallback, job->mCallbackUserdata);
+    return nullptr;
+}
+
+AsyncJobHandleImpl::AsyncJobHandleImpl(PostWorkerJobCallback cb, void* userdata)
+    : mCallback(cb), mCallbackUserdata(userdata) {
+    namespace w = aleks2::dawn_worker;
+    pthread_attr_t attr;
+    std::size_t defaultSize = 0;
+    int error = pthread_attr_init(&attr);
+    if (error == 0) {
+        pthread_attr_getstacksize(&attr, &defaultSize);
+        error = pthread_attr_setstacksize(&attr, w::kStackSize);
+        if (error == 0) {
+            error = pthread_create(&mPThread, &attr, &AsyncJobHandleImpl::SwitchThreadEntry, this);
+        }
+        pthread_attr_destroy(&attr);
+    }
+    w::stackDefault.store(defaultSize, std::memory_order_relaxed);
+    if (error == 0) {
+        mPThreadStarted = true;
+        w::stackSize.store(w::kStackSize, std::memory_order_relaxed);
+        w::threads.fetch_add(1, std::memory_order_relaxed);
+    } else {
+        // Out of memory for the stack, say: keep Dawn working on the default stack, and say so in the log.
+        w::lastError.store(error, std::memory_order_relaxed);
+        w::fallbacks.fetch_add(1, std::memory_order_relaxed);
+        mThread = std::thread(&AsyncJobHandleImpl::JobThreadLoop, this, cb, userdata);
+    }
+}
