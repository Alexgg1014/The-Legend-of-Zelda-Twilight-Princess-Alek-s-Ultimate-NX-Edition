# aleks2 (H36): the parts of the static-mod build that need no target -- checking a
# selection and writing the built-in mod table -- kept apart from StaticMods.cmake so
# that platforms/switch/tools/test-static-mods.sh can run them in CMake script mode on
# any machine. StaticMods.cmake and the root CMakeLists.txt call these.
include_guard(GLOBAL)

# Checks ALEKS2_STATIC_MODS (directory names under `mods_dir`, passed quoted as one
# argument so an empty entry survives to be reported) and stops the configure with a
# message naming what is wrong.
function(aleks2_check_static_mod_selection mods_dir selection)
    set(_seen "")
    foreach (_mod IN LISTS selection)
        if (_mod STREQUAL "")
            message(FATAL_ERROR "ALEKS2_STATIC_MODS: empty entry (a stray ';'?)")
        endif ()
        if (_mod MATCHES "[/\\\\]" OR _mod MATCHES "^\\.")
            message(FATAL_ERROR "ALEKS2_STATIC_MODS: '${_mod}' is not a directory name under mods/")
        endif ()
        if (_mod IN_LIST _seen)
            message(FATAL_ERROR "ALEKS2_STATIC_MODS: '${_mod}' is listed twice")
        endif ()
        list(APPEND _seen "${_mod}")
        if (NOT EXISTS "${mods_dir}/${_mod}/CMakeLists.txt")
            if (IS_DIRECTORY "${mods_dir}/${_mod}")
                # cosmetics and randomizer are submodules: an empty folder is one that
                # was never checked out, which deserves the command rather than "no such mod".
                message(FATAL_ERROR "ALEKS2_STATIC_MODS: 'mods/${_mod}' has no CMakeLists.txt; "
                        "if it is a submodule, run: git submodule update --init mods/${_mod}")
            endif ()
            message(FATAL_ERROR "ALEKS2_STATIC_MODS: no such mod 'mods/${_mod}'")
        endif ()
    endforeach ()
endfunction()

# Sets `out_var` to the source of switch_builtin_mods_table.cpp for mods whose target
# names and ids are given in the same order. Two mods with one id would leave the
# second unreachable, so that stops the configure.
function(aleks2_builtin_mods_table out_var)
    cmake_parse_arguments(ARG "" "" "TARGETS;IDS" ${ARGN})
    list(LENGTH ARG_TARGETS _count)
    list(LENGTH ARG_IDS _id_count)
    if (NOT _count EQUAL _id_count)
        message(FATAL_ERROR "aleks2_builtin_mods_table: ${_count} target(s) but ${_id_count} id(s)")
    endif ()

    set(_declarations "")
    set(_rows "")
    set(_seen_ids "")
    if (_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach (_index RANGE 0 ${_last})
            list(GET ARG_TARGETS ${_index} _target)
            list(GET ARG_IDS ${_index} _id)
            if (_id IN_LIST _seen_ids)
                message(FATAL_ERROR "aleks2: two mods compiled into the NRO share the id '${_id}'")
            endif ()
            list(APPEND _seen_ids "${_id}")
            if (NOT _target MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
                message(FATAL_ERROR "aleks2: mod target '${_target}' cannot prefix a C symbol")
            endif ()
            string(APPEND _declarations
                    "extern const ModMeta ${_target}__mod_meta;\n"
                    "extern ModContext* ${_target}__mod_ctx;\n"
                    "ModResult ${_target}__mod_initialize(ModError*);\n"
                    "ModResult ${_target}__mod_update(ModError*);\n"
                    "ModResult ${_target}__mod_shutdown(ModError*);\n")
            string(APPEND _rows
                    "    {\n"
                    "        \"${_id}\",\n"
                    "        &${_target}__mod_meta,\n"
                    "        &${_target}__mod_ctx,\n"
                    "        reinterpret_cast<void*>(&${_target}__mod_initialize),\n"
                    "        reinterpret_cast<void*>(&${_target}__mod_update),\n"
                    "        reinterpret_cast<void*>(&${_target}__mod_shutdown),\n"
                    "    },\n")
        endforeach ()
    endif ()

    string(CONFIGURE
"// Generated by platforms/switch/cmake/StaticMods.cmake. Do not edit.
//
// One row per mod compiled into this build. The symbol names carry the mod's
// target name because objcopy renamed them while sealing: without that, two
// mods would both define mod_initialize.
#include \"dusk/switch_builtin_mods.hpp\"

#include <mods/api.h>

extern \"C\" {
@_declarations@}

namespace dusk::mods::loader::detail {

const BuiltinMod kBuiltinMods[] = {
@_rows@    {nullptr, nullptr, nullptr, nullptr, nullptr, nullptr},
};

}  // namespace dusk::mods::loader::detail
" _content @ONLY)
    set(${out_var} "${_content}" PARENT_SCOPE)
endfunction()
