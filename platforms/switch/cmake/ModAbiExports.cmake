# aleks2: keep the surface a loaded mod needs to bind against.
#
# A native mod ships lib/linux-aarch64/mod.so, which is already the right
# architecture for this console, so running one comes down to resolving what it
# asks for. Measured against five published mods (aleks2/tools/probe-mod-abi.py),
# 88-93% of what they want is already in the NRO. What is missing splits in two,
# and neither half needs code written:
#
#  * Functions nothing in the game happens to call, so the linker never pulled
#    their archive member in: __stack_chk_fail, __snprintf_chk, __cxa_atexit and
#    friends. All eight are in devkitA64's own libc.a and libstdc++.a. Naming
#    them as undefined roots is enough.
#
#  * Game and Dawn functions that DO exist in our objects but that
#    --gc-sections threw away, because the game does not call them either:
#    dComIfGs_setBombMax, daAlink_c::procMoveInit,
#    wgpuRenderPipelineGetBindGroupLayout... A mod calls plenty of those.
#
# --export-dynamic is the obvious way to keep the second group and it does not
# work here: it makes EVERY global symbol a root, and this build relies on
# --gc-sections to drop code that cannot link on Switch at all -- abseil's
# LowLevelAlloc (absent when ABSL_LOW_LEVEL_ALLOC_MISSING), its per-thread
# semaphores, and lstat64 from Rust's std. Keeping all of it fails the link.
#
# So the surface is named instead, through --dynamic-list: the symbols in the
# list become roots (kept, and in .dynsym where a loader can find them) and
# nothing else changes. The list is generated by tools/gen-mod-abi-list.py from
# what published mods actually ask for, intersected with what this build can
# really provide.
#
# The cost is size and nothing else: no codegen changes, so no frames lost --
# which is why this is separate from DUSK_ENABLE_CODE_MODS, whose hook-friendly
# options do cost frames on Tegra.

if (NOT ALEKS2_MOD_ABI)
    return ()
endif ()

# In devkitA64's libc.a / libstdc++.a, but referenced by mods rather than by the
# game. __cxa_thread_atexit_impl is deliberately absent: it is bionic's, and the
# library we load is the Linux one.
set(_aleks2_mod_abi_symbols
        __cxa_atexit
        __cxa_finalize
        __cxa_pure_virtual
        __cxa_thread_atexit
        __snprintf_chk
        __stack_chk_fail
        __stack_chk_guard)

# And the ones the probes turned up, which are the same kind of thing: present in
# the toolchain, referenced only by mods.
set(_aleks2_pinned_file "${CMAKE_CURRENT_SOURCE_DIR}/mod_abi_pinned.txt")
# H37-c5: and game functions the linker would drop because the Switch build never calls them but a mod
# hooks by name (mod_hook_roots.txt, written by hand): same treatment, a root that stays in the image.
set(_aleks2_hook_roots_file "${CMAKE_CURRENT_SOURCE_DIR}/mod_hook_roots.txt")
foreach (_pinned IN ITEMS "${_aleks2_pinned_file}" "${_aleks2_hook_roots_file}")
    if (EXISTS "${_pinned}")
        file(STRINGS "${_pinned}" _aleks2_pinned_lines)
        foreach (_line IN LISTS _aleks2_pinned_lines)
            if (NOT _line MATCHES "^#" AND NOT _line STREQUAL "")
                list(APPEND _aleks2_mod_abi_symbols "${_line}")
            endif ()
        endforeach ()
        list(REMOVE_DUPLICATES _aleks2_mod_abi_symbols)
        set_property(TARGET dusklight APPEND PROPERTY LINK_DEPENDS "${_pinned}")
    endif ()
endforeach ()

# H37: what the native mods V1 loads at run time require, by name, from the mods themselves
# (platforms/switch/mod_required_symbols.txt, made by tools/gen_required_symbols.py). The
# loader resolves a mod's imports only against this image's .dynsym
# (src/dusk/mods/loader/image_symbols.cpp), so a name has to be exported to be found at all:
#  * every `import` line joins the dynamic list below -- named, one by one; nothing is
#    exported wholesale;
#  * the ones that are C or C++ runtime names (libc, libm, libstdc++, libgcc, and the
#    glibc-compatible names switch_mod_libc.cpp defines) are also --undefined roots, because
#    the linker only pulls an archive member in for a reference, and a dynamic-list entry is
#    not one. A name that nothing defines stays out of .dynsym without failing the link;
#    check_symbol_manifest.py reports it after the link (SymbolManifestSwitch.cmake).
#  * H37-c2: a name defined with hidden visibility (libgcc's soft-float and 128-bit helpers,
#    libgcc_eh's _Unwind_Resume, the libm square roots) stays out of .dynsym whatever this list
#    says -- the linker makes it local. Those few resolve through the image runtime table,
#    src/dusk/mods/loader/elf_image_runtime.c, which names each one explicitly.
set(_aleks2_required_file "${CMAKE_CURRENT_SOURCE_DIR}/mod_required_symbols.txt")
set(_aleks2_required_imports "")
if (EXISTS "${_aleks2_required_file}")
    file(STRINGS "${_aleks2_required_file}" _aleks2_required_lines REGEX "^[^# ]+ import ")
    foreach (_line IN LISTS _aleks2_required_lines)
        if (_line MATCHES "^[^ ]+ import ([^ ]+) ([^ ]+)$")
            list(APPEND _aleks2_required_imports "${CMAKE_MATCH_2}")
            if (NOT CMAKE_MATCH_1 STREQUAL "game")
                list(APPEND _aleks2_mod_abi_symbols "${CMAKE_MATCH_2}")
            endif ()
        endif ()
    endforeach ()
    list(REMOVE_DUPLICATES _aleks2_required_imports)
    list(REMOVE_DUPLICATES _aleks2_mod_abi_symbols)
    set_property(TARGET dusklight APPEND PROPERTY LINK_DEPENDS "${_aleks2_required_file}")
endif ()

# H37-c1: the roots go to GNU ld in a response file, one `--undefined=NAME` per line, through a
# single `-Wl,@<file>` -- not as one option each. With the native loader's runtime imports they
# are 321 options and about 14 500 characters, and the link command, run through cmd.exe by
# Ninja on Windows, failed at about 17 500 (cmd.exe takes 8191). ld reads the file itself
# (binutils' expandargv), so no command line anywhere -- cmd.exe, the gcc driver, collect2 --
# carries the list; the file name may contain spaces (it is one argument) but not a comma, which
# -Wl would split on. Same names, same order as before; --undefined is a global option, so its
# place on the command line does not matter. The file is rewritten only when its content changes,
# and the link depends on it, so a change to the lists relinks and nothing else does.
set(_aleks2_undefined_text "")
foreach (_symbol IN LISTS _aleks2_mod_abi_symbols)
    # ld's @file syntax splits on whitespace and treats quotes and backslashes specially; a
    # linkage name has none of them, and anything else is refused rather than quoted.
    if (NOT _symbol MATCHES "^[A-Za-z0-9_.$]+$")
        message(FATAL_ERROR "aleks2: '${_symbol}' is not a symbol name ld can read from a response file")
    endif ()
    string(APPEND _aleks2_undefined_text "--undefined=${_symbol}\n")
endforeach ()
set(_aleks2_undefined_file "${CMAKE_CURRENT_BINARY_DIR}/mod_abi_undefined.rsp")
if (_aleks2_undefined_file MATCHES ",")
    message(FATAL_ERROR "aleks2: the build directory may not contain a comma: -Wl would split "
            "'${_aleks2_undefined_file}' there")
endif ()
file(WRITE "${_aleks2_undefined_file}.tmp" "${_aleks2_undefined_text}")
file(COPY_FILE "${_aleks2_undefined_file}.tmp" "${_aleks2_undefined_file}" ONLY_IF_DIFFERENT)
file(REMOVE "${_aleks2_undefined_file}.tmp")
target_link_options(dusklight PRIVATE "-Wl,@${_aleks2_undefined_file}")
set_property(TARGET dusklight APPEND PROPERTY LINK_DEPENDS "${_aleks2_undefined_file}")
# The lists are read at configure time: editing one must reconfigure, not only relink.
foreach (_list IN ITEMS "${_aleks2_pinned_file}" "${_aleks2_hook_roots_file}" "${_aleks2_required_file}")
    if (EXISTS "${_list}")  # Ninja refuses a dependency on a file that is not there
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_list}")
    endif ()
endforeach ()

# The pinned runtime symbols and the required imports, as a second --dynamic-list (ld
# accumulates them): before H37 the pinned ones were kept but not exported.
set(_aleks2_exports ${_aleks2_mod_abi_symbols} ${_aleks2_required_imports})
list(REMOVE_DUPLICATES _aleks2_exports)
list(SORT _aleks2_exports)
set(_aleks2_exports_text "/* Generated by ModAbiExports.cmake from mod_abi_pinned.txt and mod_required_symbols.txt. */\n{\n")
foreach (_symbol IN LISTS _aleks2_exports)
    string(APPEND _aleks2_exports_text "  ${_symbol};\n")
endforeach ()
string(APPEND _aleks2_exports_text "};\n")
set(_aleks2_required_list "${CMAKE_CURRENT_BINARY_DIR}/mod_abi_required.txt")
file(WRITE "${_aleks2_required_list}.tmp" "${_aleks2_exports_text}")
file(COPY_FILE "${_aleks2_required_list}.tmp" "${_aleks2_required_list}" ONLY_IF_DIFFERENT)
file(REMOVE "${_aleks2_required_list}.tmp")
target_link_options(dusklight PRIVATE "-Wl,--dynamic-list=${_aleks2_required_list}")
set_property(TARGET dusklight APPEND PROPERTY LINK_DEPENDS "${_aleks2_required_list}")
list(LENGTH _aleks2_required_imports _required_count)
message(STATUS "aleks2: ${_required_count} import(s) required by the native mods exported by name")

list(LENGTH _aleks2_mod_abi_symbols _count)

# The generated surface, if it has been generated. Without it the pinned symbols
# above still work, so a fresh checkout builds and only loses what mods would
# have called.
set(_aleks2_dynamic_list "${CMAKE_CURRENT_SOURCE_DIR}/mod_abi_surface.txt")
if (EXISTS "${_aleks2_dynamic_list}")
    target_link_options(dusklight PRIVATE "-Wl,--dynamic-list=${_aleks2_dynamic_list}")
    set_property(TARGET dusklight APPEND PROPERTY LINK_DEPENDS "${_aleks2_dynamic_list}")
    file(STRINGS "${_aleks2_dynamic_list}" _aleks2_list_lines)
    list(LENGTH _aleks2_list_lines _list_count)
    message(STATUS "aleks2: mod ABI surface kept (${_count} pinned + "
            "${_list_count} lines of mod_abi_surface.txt)")
else ()
    message(STATUS "aleks2: mod ABI surface kept (${_count} pinned; "
            "no mod_abi_surface.txt, so run tools/gen-mod-abi-list.py for the rest)")
endif ()
